# Optional. If set, SpecTrace AI uses Groq (free-tier friendly, OpenAI-compatible,
# LPU-accelerated inference) for the LLM Extraction & Enrichment agents --
# recommended for messy / unstructured text and free-form descriptions.
# If NOT set, the pipeline runs fully offline using the rule-based regex +
# taxonomy extraction agents (Ingestion, Extraction, Normalization, Validation,
# Enrichment, Graph agents all still run -- only the optional LLM boost is skipped).
#
# Get a free API key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Defaults to openai/gpt-oss-20b -- fast, comfortably within Groq's
# free-tier rate limits. Swap to openai/gpt-oss-120b for higher-quality
# extraction/description if your free-tier quota allows it.
GROQ_MODEL=openai/gpt-oss-20b

# Confidence threshold below which an attribute is routed to the
# Human-in-the-Loop review queue instead of auto-publishing.
CONFIDENCE_THRESHOLD=0.75
